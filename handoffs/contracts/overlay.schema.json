{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "rarebridge.handoff.v1"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Source"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Edge"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Asset"
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Contact"
      }
    },
    "assessment_bundles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Bundle"
      }
    },
    "disease_synonyms": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "review_log": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReviewLog"
      }
    },
    "coverage_note": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "sources",
    "nodes",
    "edges",
    "assets",
    "contacts",
    "assessment_bundles",
    "disease_synonyms",
    "review_log",
    "coverage_note"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rarebridge:overlay:v1",
  "$defs": {
    "Source": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "published_on": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_kind": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "url",
        "aliases",
        "published_on",
        "source_kind",
        "note"
      ],
      "additionalProperties": true
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string"
        },
        "polarity": {
          "enum": [
            "support",
            "refute",
            "uncertain"
          ]
        },
        "review_status": {
          "enum": [
            "pending",
            "source_checked"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "evidence_type": {
          "enum": [
            "human_observational",
            "animal_model",
            "in_vitro",
            "computational",
            "review",
            "other",
            "unknown"
          ]
        }
      },
      "required": [
        "source_id",
        "polarity",
        "review_status",
        "rationale"
      ],
      "additionalProperties": true
    },
    "Check": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "category": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "next_question": {
          "type": "string"
        },
        "contact_role": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "question",
        "required",
        "evidence",
        "next_question",
        "contact_role"
      ],
      "additionalProperties": true
    },
    "Contact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "organization",
            "researcher",
            "study_team"
          ]
        },
        "url": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_status": {
          "enum": [
            "pending",
            "source_checked"
          ]
        },
        "last_checked": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "label",
        "kind",
        "url",
        "role",
        "source_ids",
        "review_status",
        "last_checked"
      ],
      "additionalProperties": true
    },
    "Asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "access_status": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "goal_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_disease_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owner_status": {
          "type": "string"
        },
        "public_researcher_routes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "url"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "id",
        "label",
        "type",
        "url",
        "access_status"
      ],
      "additionalProperties": true
    },
    "Bundle": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "target_disease": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "label"
          ],
          "additionalProperties": true
        },
        "goal": {
          "type": "string"
        },
        "goal_id": {
          "const": "natural_history"
        },
        "asset": {
          "$ref": "#/$defs/Asset"
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Source"
          }
        },
        "coverage": {
          "type": "string"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Check"
          }
        }
      },
      "required": [
        "id",
        "target_disease",
        "goal",
        "goal_id",
        "asset",
        "sources",
        "coverage",
        "checks"
      ],
      "additionalProperties": true
    },
    "Node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "review_status": {
          "enum": [
            "pending",
            "source_checked"
          ]
        }
      },
      "required": [
        "id",
        "type",
        "label"
      ],
      "additionalProperties": true
    },
    "Edge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "relation": {
          "type": "string"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "source_url": {
              "type": "string"
            },
            "retrieved_on": {
              "type": "string"
            }
          },
          "required": [
            "source_url",
            "retrieved_on"
          ],
          "additionalProperties": true
        },
        "review_status": {
          "enum": [
            "pending",
            "source_checked"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence_label": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "claim_origin": {
          "enum": [
            "recorded",
            "imported",
            "inferred"
          ]
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "relation",
        "provenance",
        "review_status",
        "source_ids",
        "confidence_label",
        "explanation",
        "claim_origin"
      ],
      "additionalProperties": true
    },
    "ReviewLog": {
      "type": "object",
      "properties": {
        "claim_or_check_id": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "source_location": {
          "type": "string"
        },
        "assertion_checked": {
          "type": "string"
        },
        "review_status": {
          "enum": [
            "pending",
            "source_checked"
          ]
        },
        "checked_by": {
          "type": "string"
        },
        "checked_on": {
          "type": "string"
        },
        "caveat": {
          "type": "string"
        }
      },
      "required": [
        "claim_or_check_id",
        "source_id",
        "source_location",
        "assertion_checked",
        "review_status",
        "checked_by",
        "checked_on",
        "caveat"
      ],
      "additionalProperties": true
    }
  }
}
