# Copy to .env; this file is a template, not a credential.
RAREBRIDGE_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional only for a key that is not scoped to one Anthropic workspace.
ANTHROPIC_WORKSPACE_ID=
# To use OpenAI, set provider=openai and model=gpt-4o-mini.
OPENAI_API_KEY=
RAREBRIDGE_AI_MODEL=claude-sonnet-4-6
# auto: reuse a matching genuine cached response, otherwise call the selected provider.
# live: always call the provider; cache: only matching cached responses; off: disabled.
RAREBRIDGE_AI_MODE=auto
RAREBRIDGE_AI_TIMEOUT_SECONDS=40
RAREBRIDGE_AI_MAX_OUTPUT_TOKENS=6000
# Relative paths resolve from the workspace root.
RAREBRIDGE_AI_CACHE_DIR=rarebridge/ai/cache
# Optional deployment credential; consumed by scripts/deploy_vercel.py only.
VERCEL_TOKEN=
# Optional actual team/account and project IDs; no guessed IDs.
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
