# Copy to .env.local to switch modes. This is public endpoint configuration,
# never a secret: it is compiled into the browser bundle.
#
# Empty (default): demo mode, replays saved responses from src/fixtures/.
# Set:             live mode against the local RareBridge API.
VITE_API_BASE_URL=
# VITE_API_BASE_URL=http://127.0.0.1:8000
